<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record model="ir.ui.view" id="equimenttype_view">
            <field name="name">equimenttype_form</field>
            <field name="model">equiment.type</field>
            <field name="arch" type="xml">
                <form string="Service Provider Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="equimenttype_tree_view" model="ir.ui.view">
            <field name="name">equiment Type</field>
            <field name="model">equiment.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="equimenttype_menu_action" model="ir.actions.act_window">
            <field name="name">Assets Type</field>
            <field name="res_model">equiment.type</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="context" eval="{'search_default_male': 1}"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create The First Equiment Type
                </p>
            </field>
        </record>

        <!-- Optional Menu Item (Uncomment if needed) -->
        <!--
        <menuitem id="equimenttype_models_menu"
                  parent="asset.menu_maintenance_config"
                  name="Assets Type"
                  action="equimenttype_menu_action"
                  sequence="130"/>
        -->

    </data>
</odoo>

