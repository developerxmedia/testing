<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record model="ir.ui.view" id="equimentCategory_view">
            <field name="name">equimentCategory_form</field>
            <field name="model">equiment.category</field>
            <field name="arch" type="xml">
                <form string="Asset Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="equimentCategory_tree_view" model="ir.ui.view">
            <field name="name">equimentCategory_tree</field>
            <field name="model">equiment.category</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="equimentCategory_menu_action" model="ir.actions.act_window">
            <field name="name">Asset Category</field>
            <field name="res_model">equiment.category</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="context" eval="{'search_default_male': 1}"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create the first Asset Category
                </p>
            </field>
        </record>

        <!-- Optional Menu (uncomment if needed) -->
        <!--
        <menuitem id="equimentCategory_models_menu"
                  parent="asset.menu_maintenance_config"
                  name="Asset Category"
                  action="equimentCategory_menu_action"
                  sequence="131"/>
        -->

    </data>
</odoo>

