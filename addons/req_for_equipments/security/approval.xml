<?xml version="1.0" encoding="utf-8"?>

<odoo>
<!-- CATEGORY -->
    <record id="approval_module_access" model="ir.module.category">
        <field name="name">Approval Access</field>
        <field name="description">Approval Before Confirm</field>
    </record>
    <record id="request_module_access" model="ir.module.category">
        <field name="name">Request Access</field>
        <field name="description">Approval Before Confirm</field>
    </record>
<!-- groups -->

    <record id="approval_access_for_equipments" model="res.groups">
        <field name="name">Approval Person</field>
        <field name="category_id" ref="approval_module_access"/> 
    </record>

    <record id="request_access_for_equipments" model="res.groups">
        <field name="name">Request Person</field>
        <field name="category_id" ref="request_module_access"/> 
    </record>



    <record model="ir.rule" id="request_person">
        <field name="name">Request Access</field>
        <field name="model_id" ref="model_request_for_equipments"></field>
        <field name="domain_force">[('req_by','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('request_access_for_equipments'))]"/> 
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_read" eval="1"/>
    </record>
    


</odoo>