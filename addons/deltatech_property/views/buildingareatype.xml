<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form View for Building/Facility Type -->
        <record id="buildingarea_form_view" model="ir.ui.view">
            <field name="name">buildingarea.type.form</field>
            <field name="model">buildingarea.type</field>
            <field name="arch" type="xml">
                <form string="Building/Facility Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View (optional but recommended for usability) -->
        <record id="buildingarea_tree_view" model="ir.ui.view">
            <field name="name">buildingarea.type.tree</field>
            <field name="model">buildingarea.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- Action Window -->
        <record id="buildingarea_menu_action" model="ir.actions.act_window">
            <field name="name">Building/Facility Types</field>
            <field name="res_model">buildingarea.type</field>
            <field name="view_mode">tree,form</field>
            <field name="context" eval="{}"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create your first Building/Facility Type.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="buildingarea_models_menu"
                  parent="base.menu_property_config"
                  name="Building/Facility Type"
                  action="buildingarea_menu_action"
                  sequence="104"/>

    </data>
</odoo>
