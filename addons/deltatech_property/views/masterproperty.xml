<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Form View -->
    <record model="ir.ui.view" id="propertytypes_view">
      <field name="name">propertymasterline.form</field>
      <field name="model">master.property.line</field>
      <field name="arch" type="xml">
        <form string="Property Master Line">
          <sheet>
            <group>
              <field name="name"/>
              <field name="propertyline"/>
              <field name="floors"/>
              <field name="rooms"/>
              <!-- <field name="propertynames"/> -->
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Tree View -->
    <record id="master_status_tree_view" model="ir.ui.view">
      <field name="name">master.property.line.tree</field>
      <field name="model">master.property.line</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="floors"/>
          <field name="rooms"/>
        </tree>
      </field>
    </record>

    <!-- Action (only one needed) -->
    <record id="propertymaster_menu_action" model="ir.actions.act_window">
      <field name="name">Property Master</field>
      <field name="res_model">master.property.line</field>
      <field name="view_mode">tree,form</field>
      <field name="context" eval="{}"/>
      <field name="domain">[]</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">Create the first Property Master Line.</p>
      </field>
    </record>

    <!-- Menu -->
    <menuitem id="propertymasterline_models_menu"
              parent="base.menu_property_info"
              name="Property Master"
              action="propertymaster_menu_action"
              sequence="20"/>
  </data>
</odoo>

