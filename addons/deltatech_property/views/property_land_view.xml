<?xml version="1.0" ?>
<odoo>
    <data>

        <!-- Kanban View -->
        <record id="view_property_land_kanban" model="ir.ui.view">
            <field name="name">property.land.kanban</field>
            <field name="model">property.land</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('property.land', 'image', record.id.raw_value)" alt="Logo"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                        <field name="new_property" invisible="1"/>
                                    </strong>
                                    <div>
                                        <field name="owner_id"/>
                                        <field name="city"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_property_land_tree" model="ir.ui.view">
            <field name="name">property.land.tree</field>
            <field name="model">property.land</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="new_property"/>
                    <field name="owner_id"/>
                    <field name="propertytype"/>
                    <!--
                    <field name="location_type"/>
                    <field name="tarla"/>
                    <field name="parcela"/>
                    <field name="city"/>
                    <field name="categ_id"/>
                    -->
                    <field name="surface" sum="surface"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_property_land_form" model="ir.ui.view">
            <field name="name">property.land.form</field>
            <field name="model">property.land</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="open_create" type="object" class="oe_highlight" string="Create Building"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                            </button>
                            <button name="attachment_tree_view" type="object" class="oe_stat_button" icon="fa-files-o">
                                <field name="doc_count" string="Documents" widget="statinfo"/>
                            </button>
                            <!--
                            <button name="show_map" type="object" class="oe_stat_button" icon="fa-location-arrow" string="Location"/>
                            -->
                            <button name="show_building" type="object" class="oe_stat_button" icon="fa-trello">
                                <field name="buildings_count" string="Buildings" widget="statinfo"/>
                            </button>
                            <button name="show_floor" type="object" class="oe_stat_button" icon="fa-inbox">
                                <field name="floors_count" string="Floors" widget="statinfo"/>
                            </button>
                            <button name="show_room" type="object" class="oe_stat_button" icon="fa-inbox">
                                <field name="rooms_count" string="Unit" widget="statinfo"/>
                            </button>
                            <button name="show_space" type="object" class="oe_stat_button" icon="fa-dot-circle-o">
                                <field name="space_count" string="Space" widget="statinfo"/>
                            </button>
                            <button name="show_equipment" type="object" class="oe_stat_button" icon="fa-stack-exchange">
                                <field name="equipment_count" string="Equipment" widget="statinfo"/>
                            </button>
                        </div>

                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title oe_left">
                            <h1>
                                <field name="name" placeholder="Property Name"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="propertytype"/>
                                <field name="propertyname" invisible="1"/>
                                <field name="new_property"/>
                                <field name="priority" invisible="1"/>
                                <field name="id" string="Property ID"/>
                            </group>
                        </group>

                        <group>
                            <group string="Identification">
                                <field name="region_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="owner_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="responsible_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="asset_number" string="Property Reference No"/>
                            </group>

                            <group string="Address">
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State"
                                           options='{"no_open": True}'
                                           context="{'country_id': country_id, 'zip': zip}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country"
                                           options='{"no_open": True, "no_create": True}'/>
                                </div>
                                <!--
                                <field name="latitude"/>
                                <field name="longitude"/>
                                -->
                            </group>
                        </group>

                        <notebook>
                            <!--
                            <page string="Building Floor List">
                                <field name="propertyline">
                                    <tree string="property" editable="bottom">
                                        <field name="propertynames"/>
                                        <field name="name" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="floors" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <field name="rooms" widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True}"/>
                                    </tree>
                                </field>
                            </page>
                            -->

                            <!--
                            <page string="Assets List">
                                <field name="equipmentline">
                                    <tree string="Equipment" editable="bottom">
                                        <field name="name"/>
                                        <field name="number"/>
                                        <field name="roomno"/>
                                        <field name="floorname"/>
                                        <field name="buildingname"/>
                                    </tree>
                                </field>
                            </page>
                            -->

                            <page string="Service List">
                                <field name="facilityline">
                                    <tree editable="bottom">
                                        <!-- <field name="name" options="{'no_create': True, 'no_create_edit':True}"/> -->
                                        <field name="servicetype" options="{'no_create': True, 'no_create_edit':True}"/>
                                        <!-- <field name="servicecategory" options="{'no_create': True, 'no_create_edit':True}"/> -->
                                    </tree>
                                </field>
                            </page>

                            <page string="Surfaces">
                                <group>
                                    <group>
                                        <field name="surface"/>
                                        <!--
                                        <label for="price"/>
                                        <div class="o_row" name="price">
                                            <field name="price"/>
                                            <span> / m³</span>
                                        </div>
                                        <field name="currency_id"/>
                                        -->
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread" placeholder="Share a message..."/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_property_land_filter" model="ir.ui.view">
            <field name="name">property.land.search</field>
            <field name="model">property.land</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="propertytype"/>
                    <field name="city"/>
                    <!--
                    <field name="parcela"/>
                    <field name="owner_id"/>
                    <separator/>
                    <filter string="Intravilan" domain="[('location_type','=','in')]" name="grup_in"/>
                    <filter string="Extravilan" domain="[('location_type','=','ex')]" name="grup_ex"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                    -->
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_property_land" model="ir.actions.act_window">
            <field name="name">IC'S</field>
            <field name="res_model">property.land</field>
            <field name="view_mode">kanban,tree,form,pivot</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_property_land"
                  name="IC'S"
                  parent="base.menu_property_app"
                  action="action_property_land"
                  sequence="114"/>
    </data>
</odoo>
