<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form View for Service Type -->
        <record model="ir.ui.view" id="facility_form_view">
            <field name="name">facility.master.form</field>
            <field name="model">facility.master</field>
            <field name="arch" type="xml">
                <form string="Service Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="servicecategory"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View (Recommended) -->
        <record id="facility_tree_view" model="ir.ui.view">
            <field name="name">facility.master.tree</field>
            <field name="model">facility.master</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="servicecategory"/>
                </tree>
            </field>
        </record>

        <!-- Action Window -->
        <record id="facility_menu_action" model="ir.actions.act_window">
            <field name="name">Service Types</field>
            <field name="res_model">facility.master</field>
            <field name="view_mode">tree,form</field>
            <field name="context" eval="{}"/>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first Service Type.</p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="facility_models_menu"
                  parent="base.menu_property_config"
                  name="Service Types"
                  action="facility_menu_action"
                  sequence="120"/>

    </data>
</odoo>
