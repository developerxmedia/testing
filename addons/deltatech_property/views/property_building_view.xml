<?xml version="1.0" ?>
<odoo>
    <data>

        <record id="view_property_building_kanban" model="ir.ui.view">
            <field name="name">property.building.kanban</field>
            <field name="model">property.building</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_card">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('property.building', 'image', record.id.raw_value)" alt="Logo"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div>
                                        <field name="propertyname"/>
                                        <field name="city"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        

        <record id="view_property_building_tree" model="ir.ui.view">
            <field name="name">Building/Area</field>
            <field name="model">property.building</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="propertyname"/>
                   <!-- <field name="owner_id"/>-->
                    <field name="asset_number"/>
                    <!-- <field name="city"/>
                    <field name="categ_id"/> -->
                    <field name="surface" sum="surface"/>
                </tree>

            </field>
        </record>

        <record id="view_property_building_form" model="ir.ui.view">
            <field name="name">property.building.form</field>
            <field name="model">property.building</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="open_createbuilding" type="object" class="oe_highlight" string="Create Floor"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                            </button>
                            <button name="attachment_tree_view" type="object" class="oe_stat_button" icon="fa-files-o">
                                <field name="doc_count" string="Documents" widget="statinfo"/>
                            </button>
                            <button name="show_floors" type="object" class="oe_stat_button" icon="fa-stack-exchange">
                                <field name="floors_count" string="Floors" widget="statinfo"/>
                            </button>
                            <button name="show_rooms" type="object" class="oe_stat_button" icon="fa-stack-exchange">
                                <field name="rooms_count" string="Unit" widget="statinfo"/>
                            </button>
                            <button name="show_internalarea" type="object" class="oe_stat_button" icon="fa-dot-circle-o">
                                <field name="internalarea_count" string="Internal Area" widget="statinfo"/>
                            </button>
                            <button name="show_equipment" type="object" class="oe_stat_button" icon="fa-outdent">
                                <field name="equipment_count" string="Equipment" widget="statinfo"/>
                            </button>
                        </div>
    
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Building Name"/></h1>
                        </div>
    
                        <group>
                            <group>
                                <field name="propertyname" options='{"no_open": True, "no_create": True}'/>
                                <field name="buildingareatype" options='{"no_open": True, "no_create": True}'/>
                                <field name="responsible_id" string="Building Manager" options='{"no_open": True, "no_create": True}'/>
                            </group>
                            <group>
                                <field name="id" string="Building ID"/>
                                <field name="new_building_name"/>
                                <field name="asset_number" string="Building Reference No"/>
                            </group>
                        </group>
    
                        <notebook>
                            <page string="Service List">
                                <field name="floors_ids">
                                    <tree editable="bottom">
                                        <field name="servicetype" options='{"no_open": True, "no_create": True}'/>
                                        <field name="serviceprovider" options='{"no_open": True, "no_create": True}'/>
                                    </tree>
                                </field>
                            </page>
                            <!-- You can uncomment and reuse these as needed -->
                            <!--
                            <page string="General">
                                ...
                            </page>
                            -->
                        </notebook>
                    </sheet>
    
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread" placeholder="Share a message..."/>
                    </div>
                </form>
            </field>
        </record>
    
        <record id="view_property_building_filter" model="ir.ui.view">
            <field name="name">property.building.search</field>
            <field name="model">property.building</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="owner_id"/>
                    <field name="city"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>
    
        <record id="action_property_building" model="ir.actions.act_window">
            <field name="name">Business Units</field>
            <field name="res_model">property.building</field>
            <field name="view_mode">kanban,tree,form,pivot</field>
        </record>
    
        <menuitem id="menu_property_building"
                    name="Business Units"
                    parent="base.menu_property_app"
                    action="action_property_building"
                    sequence="16"/>
    </data>
</odoo>
    