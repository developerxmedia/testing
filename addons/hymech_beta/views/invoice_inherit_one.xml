<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<record id="account_move_line_inherit" model="ir.ui.view">
    <field name="name">account.move.line.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="type">form</field>

    <field name="arch" type="xml">
        
        <xpath expr="//field[@name='payment_reference']" position="after">
            <field name="atten"/>
            <field name="po_number"/>
            <field name="cash_terms"  invisible="1"/>
            <field name="cheque_no"  invisible="1"/>

            <field name="cash_term_paid"/>
            <field name="cheque_num" invisible="cash_term_paid != 'cheque'"/>

            <field name="sef_number" invisible="1"/>

            <field name="paid_by" widget='radio'/>
            <field name="gst_filing"/>
            <field name="gst_status"/>
            <field name="product_name"/>
            <field name="job_code"/>
            <field name="terms_conditions"/>

            <!-- <field name="sale_id" /> -->
            <field name="dc_id" widget="many2many_tags"/>
        </xpath>

        <!-- Add Export PDF Invoice button in header -->
        <xpath expr="//header" position="inside">
            <button name="action_export_invoice_pdf" 
                    type="object" 
                    string="Export PDF Invoice" 
                    class="btn-primary"
                    invisible="move_type != 'out_invoice'"/>
        </xpath>

    </field>
</record>

        <record id="hide_accounting_invoices_report" model="res.groups">
            <field name="name">Accounting Invoice Report</field>
        </record>
        <record model="ir.actions.report" id="account.account_invoices">
            <field name="groups_id" eval="[(6,0,[ref('hide_accounting_invoices_report')])]"/>
        </record>
        
        
        
        <record id="hide_accounting_invoices_without_payment_report" model="res.groups">
            <field name="name">Payment Report</field>
        </record>
        <record model="ir.actions.report" id="account.account_invoices_without_payment">
            <field name="groups_id" eval="[(6,0,[ref('hide_accounting_invoices_without_payment_report')])]"/>
        </record>
        

</odoo>