<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="man_power_category_view" model="ir.ui.view">
        <field name="name">man.power.category.tree</field>
        <field name="model">man.power.category</field>
        <field name="arch" type="xml">
            <tree string='Man Power Tree'>
                    <field name="man_power_category"/>
                    <field name="rate_hour"/>

            </tree>
        </field>
    </record>

    <record id="man_power_category_kanban_view" model="ir.ui.view">
        <field name="name">man.power.category.kanban</field>
        <field name="model">man.power.category</field>
        <field name="arch" type="xml">
            <kanban default_group_by="man_power_category" class="o_kanban_small_column">
        
                    <field name="man_power_category"/>
                    <field name="rate_hour"/>

                  
                    <templates>
                        <t t-name='kanban-box'>
                            <div t-attf-class="oe_kanban_global_click ">
                                    <!-- <div class='o_kanban_image'>
                                        <field name="image" nolabel="1" widget="image" class="oe_right oe_avatar"/>
                                    </div> -->
                            
                                <div class='oe_kanban_details'>
                                        <strong class='o_kanban_record_title'><field name='man_power_category'/>
                                        </strong>
                                        <ul>
                                            <li> <b>category: </b><field name='man_power_category'/></li>
                                            <li> <b>Rate: </b><field name='rate_hour'/></li>
                                            <!-- <li> <b>Ward Number: </b><field name='ward_number'/></li> -->
                                        </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                    
            </kanban>
        </field>
    </record>

    <record id="man_power_category_forms_view" model="ir.ui.view">
        <field name="name">man.power.category.form</field>
        <field name="model">man.power.category</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>

                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <field name='image' widget='image'  class="oe_avatar" /> -->
                            
                        <h1><field name="man_power_category" placeholder="Category" class="text-left"/></h1>
                        
                    </div>
                    <div class='oe_right oe_title'>
                        <!-- <field name="qr_code" widget='image' style="float:left;width:50%;" class="oe_avatar"/> -->
                        
                    </div>
                    <group>
                        <field name='rate_hour' string='Rate per Hour'/>
                    </group>
                    <div class='oe_left oe_title'>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="open_man_power_category" model="ir.actions.act_window">
        <field name="name">Man Power Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">man.power.category</field>
        <field name="view_type">form</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>

<menuitem name='Master' parent='hymech' id='master' sequence='3'/>
<menuitem name='Man Power category' action='open_man_power_category' parent='master' id='man_power_category' sequence='1'/>
</data>
</odoo>