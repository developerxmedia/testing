<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<record id="delivery_move_line_inheritsz" model="ir.ui.view">
    <field name="name">stock.move.inherit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="type">form</field>

    <field name="arch" type="xml">

      <header position="inside">
            <button name="action_export_delivery_pdf"
                    type="object"
                    string="Export Delivery PDF"
                    class="btn-primary"
                   />
        </header>
        
        <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='product_id']" position="before">
            <field name="s_nodd"/>
        </xpath>
       


        </field>
        </record>


        <!-- Server Action: Export PDF Delivery Orders -->
        <record id="action_stock_picking_pdf_export" model="ir.actions.server">
            <field name="name">Export PDF Delivery Orders</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
        for record in records:
            record.action_export_delivery_pdf()
            </field>
        </record>
    </odoo>