<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Your existing order line view -->
        <record id="view_sale_order_line_inheritss" model="ir.ui.view">
            <field name="name">sale.order.line.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="before">
                    <field name="s_noss"/>
                    <field name="boq"/>
                </xpath>
            </field>
        </record>

        <!-- Your existing tree view -->
        <record id="view_order_tree_inherit_news" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="before">
                    <field name="product_name"/>
                </field>
            </field>
        </record>

        <!-- CORRECTED: PDF Export Button (remove duplicates) -->
        <record id="view_order_form_inherit_pdf_export" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.pdf.export</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_preview_sale_order']" position="after">
                    <button name="action_export_quotation_pdf" 
                            string="Export PDF Quotation" 
                            type="object" 
                            class="btn-success"/>
                </xpath>
            </field>
        </record>

        <!-- BOM stat button -->
        <record id="view_order_form_inherit_bom_button" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.bom.button</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" 
                            type="object" 
                            name="action_bom" 
                            icon="fa-flask"
                           >
                        <field name="bom_count" widget="statinfo" string="BOMs"/>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Server action for batch export -->
        <record id="action_sale_order_pdf_export" model="ir.actions.server">
            <field name="name">Export PDF Quotations</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.action_export_quotation_pdf()
            </field>
        </record>
    </data>
</odoo>