<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<record id="account_move_line_inherit_one" model="ir.ui.view">
    <field name="name">account.move.line.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="type">form</field>

    <field name="arch" type="xml">

        <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='quantity']" position="after">
            <field name="unit"  invisible="1"/>
        </xpath>
        <xpath position="before" expr="//field[@name='invoice_line_ids']/tree//field[@name='product_id']">
            <field name="s_no"/>
        </xpath>

    </field>
</record>

    <record id="view_move_tree_inherit_payment_date" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.payment.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="payment_date" optional="show"/>
            </xpath>
        </field>
    </record>
    
</odoo>