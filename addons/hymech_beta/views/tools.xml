<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="tools_desription_view" model="ir.ui.view">
        <field name="name">tools.desription.tree</field>
        <field name="model">tools.desription</field>
        <field name="arch" type="xml">
            <tree string='Tools Tree'>
                    <field name="tools_description"/>
                    <field name="cost"/>

            </tree>
        </field>
    </record>

    <record id="tools_desription_kanban_view" model="ir.ui.view">
        <field name="name">tools.desription.kanban</field>
        <field name="model">tools.desription</field>
        <field name="arch" type="xml">
            <kanban >
        
                    <field name="tools_description"/>
                    <field name="cost"/>

                  
                    <templates>
                        <t t-name='kanban-box'>
                            <div t-attf-class="oe_kanban_global_click ">
                                    <!-- <div class='o_kanban_image'>
                                        <field name="image" nolabel="1" widget="image" class="oe_right oe_avatar"/>
                                    </div> -->
                            
                                <div class='oe_kanban_details'>
                                        <strong class='o_kanban_record_title'><field name='tools_description'/>
                                        </strong>
                                        <ul>
                                            <li> <b>Tools: </b><field name='tools_description'/></li>
                                            <li> <b>Cost: </b><field name='cost'/></li>
                                            <!-- <li> <b>Ward Number: </b><field name='ward_number'/></li> -->
                                        </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                    
            </kanban>
        </field>
    </record>

    <record id="tools_desription_forms_view" model="ir.ui.view">
        <field name="name">tools.desription.form</field>
        <field name="model">tools.desription</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>

                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <field name='image' widget='image'  class="oe_avatar" /> -->
                            
                        <h1><field name="tools_description" placeholder="Tools" class="text-left"/></h1>
                        
                    </div>
                    <div class='oe_right oe_title'>
                        <!-- <field name="qr_code" widget='image' style="float:left;width:50%;" class="oe_avatar"/> -->
                        
                    </div>
                    <group>
                        <field name='cost' string='Cost'/>
                    </group>
                    <div class='oe_left oe_title'>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="open_tools_desription" model="ir.actions.act_window">
        <field name="name">Tools Description</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tools.desription</field>
        <field name="view_type">form</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>


<menuitem name='Tools category' action='open_tools_desription' parent='master' id='tools_desription' sequence='4'/>
</data>
</odoo>