<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="action_report_sale_mas_labellll" model="ir.actions.report">
      <field name="name">Quotation</field>
      <field name="model">sale.order</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">hymech_beta.buying_quotation</field>
      <field name="report_file">hymech_beta.buying_quotation</field>
      <field name="binding_model_id" ref="sale.model_sale_order"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="hymech_beta.paperformat_invoice_pdf"/>
    </record>

<template id="hymech_beta.buying_quotation" name="Quotation">
  <t t-call="web.basic_layout">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">

      <style>
        .page { 
          padding: 0 !important; 
          margin: 0 !important; 
        }

        table { 
          margin: 0 !important; 
          border-collapse: collapse; 
          width: 100%;
        }

        thead { 
          display: table-header-group;  /* Header ஒவ்வொரு பக்கத்திலும் repeat ஆகும் */
        }

        tfoot { 
          display: table-footer-group;  /* Footer repeat ஆகும் */
        }
        tbody td {
          page-break-inside: auto !important;
          overflow-wrap: break-word !important;
          word-break: break-word !important;
          white-space: normal !important;
        }



        td, th {
            font-size: 13px;
            text-align: left;
            vertical-align: top;
            padding: 4px 6px;
            border: 1px solid black;
            white-space: normal !important;  
            word-wrap: break-word !important;
            overflow-wrap: break-word !important;
          }

        /* ✅ முக்கியமான பகுதி */
        thead tr, 
        tfoot tr {
          page-break-inside: avoid !important;  /* header/footer split ஆகக் கூடாது */
        }

          tbody tr {
            page-break-inside: auto !important;  /* Row split ஆக அனுமதி */
          }

        h4, h6 { 
          margin: 0; 
          padding: 0; 
        }

        /* Remove outer borders of header block */
        .header-outer,
        .header-outer > tbody > tr > td,
        .header-outer > tbody > tr > th {
          border: 1px solid white !important;
        }

       td, th {
          page-break-inside: avoid !important;
        }
        .description-cell div {
          page-break-inside: auto !important;
        }

        .description-cell {
          page-break-inside: auto !important;   /* Description split ஆக அனுமதி */
          white-space: normal !important;
          word-break: break-word !important;
        }
        tbody td, tbody tr, .description-cell {
          page-break-inside: auto !important;  /* split allowed */
          page-break-before: auto !important;
          page-break-after: auto !important;
        }



        @page {
          @bottom-center {
            content: "This is a computer generated Quotation, No signature is required \A Please Visit: " counter(page) " of " counter(pages);
            white-space: pre;
            font-size: 11px;
            text-align: center;
          }
        }

      </style>






        <div class="page">
<h4 class="text-center" style="color:#0000ff; margin-bottom:10px; font-size:26px; font-weight:900; letter-spacing:.3px;">Quotation</h4>


<table class="table table-sm header-outer"
       style="width:100%; border-collapse: collapse; margin-bottom: 5px; border:none;">
  
  <tr>
    <!-- Left company info -->
  <td style="width: 50%; vertical-align: top; padding: 5px 5px 5px 0; border:none;">
    <t t-if="o.company_id.logo">
      <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"
           style="max-height:110px; display:block; margin-bottom:5px; padding-bottom:2em; padding-left:0em;"/>
    </t>
    <div style="font-size: 15px; font-weight: 600; line-height: 1.3;">
      <span t-field="o.company_id"/><br/>
      <span t-field="o.company_id.street"/><br/>
      <t t-if="o.company_id.street2"><span t-field="o.company_id.street2"/><br/></t>
      <t t-if="o.company_id.city"><span t-field="o.company_id.city"/></t>
      <t t-if="o.company_id.state_id"><span t-field="o.company_id.state_id"/></t>
      <t t-if="o.company_id.zip"><span t-field="o.company_id.zip"/></t><br/>
      <t t-if="o.company_id.country_id"><span t-field="o.company_id.country_id"/><br/></t>
      <strong>Tel:</strong> <span t-field="o.company_id.phone"/><br/>
      <strong>Email:</strong> <span t-field="o.company_id.email"/><br/>
      <strong>Tax Reg No#:</strong> <span t-field="o.company_id.vat"/>
    </div>
  </td>

    <!-- Right meta table -->
<td style="vertical-align: top; padding-top: 5em; padding-left: 6em; border: none;">
  <table style="width: auto; border-collapse: collapse; font-size: 15px; font-weight: 600;">
    <colgroup>
      <col style="width: 25%;"/>
      <col style="width: 30%;"/>
    </colgroup>
    <tr>
      <td style="border: 2px solid black; padding: 7px; white-space: nowrap; font-size: 15px;">Quotation #</td>
      <td style="border: 2px solid black; padding: 7px;font-size: 15px;"><span t-field="o.name"/></td>
    </tr>
    <tr>
      <td style="border: 2px solid black; padding: 7px; white-space: nowrap;font-size: 15px;">Date</td>
      <td style="border: 2px solid black; padding: 7px;font-size: 15px;"><span t-esc="o.write_date" t-options='{"widget": "date"}'/></td>
    </tr>
    <tr>
      <td style="border: 2px solid black; padding: 7px; white-space: nowrap;font-size: 15px;">Credit Terms</td>
      <td style="border: 2px solid black; padding: 7px;font-size: 15px;"><span t-field="o.cash_term_paid"/></td>
    </tr>
    <tr>
      <td style="border: 2px solid black; padding: 7px; white-space: nowrap;font-size: 15px;">Salesperson REF.</td>
      <td style="border: 2px solid black; padding: 7px;font-size: 15px;"><span t-field="o.user_id"/></td>
    </tr>
    <tr>
      <td style="border: 2px solid black; padding: 7px; white-space: nowrap;font-size: 15px;">RFQ Number</td>
      <td style="border: 2px solid black; padding: 7px;font-size: 15px;"><span t-field="o.rfq_num"/></td>
    </tr>
  </table>
</td>


  </tr> <!-- ✅ This closing tag was missing -->

  <!-- To block -->
  <tr>
  <td colspan="2" style="padding: 8px 0 5px 0; font-size: 15px; font-weight: 600; text-align: left; border: none;">
    <strong>To:</strong><br/>
    <span t-field="o.partner_id"/><br/>
    <t t-if="o.partner_id.street"><span t-field="o.partner_id.street"/><br/></t>
    <t t-if="o.partner_id.street2"><span t-field="o.partner_id.street2"/><br/></t>
    <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/></t>
    <t t-if="o.partner_id.state_id"><span t-field="o.partner_id.state_id"/></t>
    <t t-if="o.partner_id.zip"><span t-field="o.partner_id.zip"/></t><br/>
    <t t-if="o.partner_id.country_id"><span t-field="o.partner_id.country_id"/><br/></t>
    <strong>Attn:</strong> <span t-field="o.atten.name"/><br/>
    <strong>Tel:</strong> <span t-field="o.atten.phone"/><br/>
    <h4 style="margin: 5px 0 0 0; color: orange;"><strong><span t-esc="o.product_name.name"/></strong></h4>
  </td>
</tr>
</table>
          <!-- Items table (unchanged) -->
          <table style="width:100%; border: 1px solid black; border-collapse: collapse; margin-top: 5px; font-size: 13px;">
            <thead>
              <tr>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:5%; border: 1px solid black; padding: 4px;"><b>S.No</b></th>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:61%; border: 1px solid black; padding: 4px;"><b>Descriptions</b></th>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:5%; border: 1px solid black; padding: 4px;"><b>Qty</b></th>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:5%; border: 1px solid black; padding: 4px;"><b>UM</b></th>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:12%; border: 1px solid black; padding: 4px; white-space: nowrap;"><b>Unit Price<br/>In SGD</b></th>
                <th style="text-align:center;font-size: 16px !important;vertical-align:middle; width:12%; border: 1px solid black; padding: 4px; white-space: nowrap;"><b>Amount In<br/>SGD</b></th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="o.order_line" t-as="line">
                <tr>
                  <td style="text-align:center; border: 1px solid black; padding: 4px;"><span t-field="line.s_noss"/></td>
                  <td class="description-cell">
                    <div style="page-break-inside:auto; white-space:normal; word-wrap:break-word;">
                      <span t-field="line.name"/>
                    </div>
                  </td>

                  <td style="text-align:center; border: 1px solid black; padding: 4px;">
                    <t t-if="line.product_uom.name == 'cm2'">
                      <span t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                    </t>
                    <t t-else="">
                      <span t-field="line.product_uom_qty" t-options='{"widget": "integer"}'/>
                    </t>
                  </td>
                  <td style="text-align:center; border: 1px solid black; padding: 4px;"><span t-field="line.product_uom"/></td>
                  <td style="text-align:right; padding: 4px 6px; border: 1px solid black;vertical-align:middle;">$<span t-field="line.price_unit"/></td>
                  <td style="text-align:right; padding: 4px 6px; border: 1px solid black;"><span t-field="line.price_subtotal"/></td>
                </tr>
              </t>
            </tbody>

          </table>


         <!-- Footer Section -->
<div class="footer" style="font-size:13px;">


            <!-- Wrapper with flex layout -->
  <div class="last-page" style="display:flex; margin-top:20px; justify-content:space-between; align-items:flex-start; width:100%;">

    <!-- Left Side: Terms -->
    <div style="width:55%; padding-right:15px;">
      <strong>Terms and Condition:</strong><br/>
      <span t-field="o.note"/>
    </div>

<!-- Right Side: Totals (only border-top lines) -->
<div style="width:40%; max-width:240px; margin-left:auto; font-size:13px;">
  <table style="width:100%; border-collapse:collapse; font-size:13px; border:none;border-color: transparent !important;">
    <tr>
      <td style="padding:3px 5px; text-align:left; border:none; border-top:1px solid #000;">
        <strong>Subtotal</strong>
      </td>
      <td style="padding:3px 5px; text-align:right; border:none; border-top:1px solid #000;">
        <span t-field="o.amount_untaxed"/>
      </td>
    </tr>
    <tr>
      <td style="padding:3px 5px; text-align:left; border:none; border-top:1px solid #000;">
        <strong>GST 9%</strong>
      </td>
      <td style="padding:3px 5px; text-align:right; border:none; border-top:1px solid #000;">
        <span t-field="o.amount_tax"/>
      </td>
    </tr>
    <tr>
      <td style="padding:3px 5px; text-align:left; font-weight:bold; border:none; border-top:1px solid #000;">
        <strong>Total</strong>
      </td>
      <td style="padding:3px 5px; text-align:right; font-weight:bold; border:none; border-top:1px solid #000;">
        <span t-field="o.amount_total"/>
      </td>
    </tr>
  </table>
</div>



  </div>

  <!-- Bottom Center Note -->
  <div style="text-align:center; margin-top:15px; font-size:11px;">
    <h6 style="margin: 0 !important"><b>This is a computer generated Quotation, No signature is required</b></h6><br/>
    <h6 style="margin: 0 !important"><strong>Please Visit:</strong> <span t-field="o.company_id.website"/><br/>
    Page <span class="page"/> of <span class="topage"/></h6>
  </div>

</div>

        </div>

      </t>
    </t>
  </t>
</template>

  </data>
</odoo>
