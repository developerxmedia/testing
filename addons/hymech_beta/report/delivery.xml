    <div class="footer"> -->
    
     <h6 class="text-center">
    <div style="text-align: center;">
    <b>This is a computer generated Delivery Order, No signature is required</b></div>
    <br></br>
    <!-- <b>  Please Visit: www.hymech.org  </b> -->
      <strong>Please Visit :</strong> <span t-field="o.company_id.website"/><br></br>
