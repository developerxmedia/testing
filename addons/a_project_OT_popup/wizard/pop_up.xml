<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_wizard" model="ir.ui.view">
        <field name="name">Pdf.generation.form</field>
        <field name="model">hr.wizard</field>
        <field name="arch" type="xml">
        <form string="generation fichier">
            <group>
                <field name="message" />
            </group>
            <footer>
                <button string="OK" special="cancel" class="oe_highlight"/>
            </footer>
        </form>
        </field>
    </record>

    <record id="open_popupwizard" model="ir.actions.act_window">
        <field name="name">OverTime Notification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.wizard</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="pop_up" name="pop up"  action="open_popupwizard" sequence="1"/>

</odoo>