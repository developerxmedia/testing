<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_btn_cancel_form" model="ir.ui.view">
        <field name="name">view.btn.cancle.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="replace">
                <button name="action_cancel" string="Cancel" type="object" invisible="state in ['assigned','confirmed','done','partially_available','draft','waiting']"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_set_draft" invisible="state == 'cancel'" string="Set To Draft" type="object" />
            </xpath>
        </field>
    </record>

</odoo>
