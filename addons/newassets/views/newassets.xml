<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!--form view of the brand menu-->
    <record model="ir.ui.view" id="equipment_view">
      <field name="name">equipment_form</field>
      <field name="model">equipment.assets</field>
      <field name="arch" type="xml">
        <form string="Equipment">
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button class="oe_stat_button" name="attachment_tree_view" type="object" icon="fa-files-o">
                <field string="Document" name="doc_count" widget="statinfo"/>
              </button>

              <button class="oe_stat_button" name="button_risk_management_view" type="object" icon="fa-files-o">
                <field string="Risk" name="risk_count" widget="statinfo"/>
              </button>
            </div>

            <field name="image_medium" widget="image" class="oe_avatar oe_left" string="Asset Image"/>

            <h1>
              <group>
                <group>
                  <field name="names"/>
                </group>
              </group>
            </h1>
            <group>
              <group>
                <field name="project_id" string="Project Name"/>
              </group>
            </group>
            <group>
              <group>
                <field name="id" string="Asset ID"/>
              </group>
            </group>

            <group>
              <group>
                <field name="category_ids" options="{'no_create': True, 'no_create_edit':True}"/>
              </group>
            </group>
            <group>
              <group>
                <field name="equipmentcat" options="{'no_create': True, 'no_create_edit':True}"/>
              </group>
            </group>
            <group>
              <group>
                <field name="asset_classfication" options="{'no_create': True, 'no_create_edit':True}"/>
              </group>
            </group>
            <!-- <group>  <group> <field name="category_ids"  options="{'no_create': True, 'no_create_edit':True}"/></group></group> -->

            <group>
              <group>
                <field name="propertys" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="floors" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="subarea" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="criticality"/>
                <field name="serviceprovider" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="description"/>
              </group>

              <group>
                <field name="buildings" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="rooms" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="active"/>
                <field name="iotequipment"/>
                <!-- <field name="qrcodes"/> -->
                <field name="qr_code_image" widget="image" class="oe_avatar"/>
                <!-- <field name="length"/>
                     <field name="width"/>
                     <field name="height"/> -->
              </group>
            </group>
            <notebook>
              <page name="info" string="Info">
                <group>
                  <group>
                    <field name="asset_number"/>
                    <field name="classification"/>
                    <field name="sensitivity_level"/>
                    <field name="model"/>
                    <field name="serial"/>
                  </group>
                </group>

                <group string="Warranty">
                  <group>
                    <!-- <field name="manufacturer_id"/> -->
                    <field name="vendor_id"/>
                    <field name="purchase_date"/>
                    <field name="warranty_start_date"/>
                  </group>
                  <group>
                    <field name="start_date"/>
                    <field name="warranty_end_date"/>
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!--treeview-->
    <record id="equipment_tree_view" model="ir.ui.view">
      <field name="name">Assets</field>
      <field name="model">equipment.assets</field>
      <field name="arch" type="xml">
        <tree string="Assets">
          <field name="names"/>
          <field name="asset_number"/>
          <field name="equipmentcat"/>
        </tree>
      </field>
    </record>

    <!--searchview-->
    <record id="view_equipments_search" model="ir.ui.view">
      <field name="name">equipment.assets.search</field>
      <field name="model">equipment.assets</field>
      <field name="arch" type="xml">
        <search string="Search Assets">
          <field name="names"/>
          <field name="asset_number"/>
          <field name="equipmentcat"/>
        </search>
      </field>
    </record>

    <!-- Asset Kanban View  -->
    <record model="ir.ui.view" id="equipment_kanban_view">
      <field name="name">equipment Kanban</field>
      <field name="model">equipment.assets</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="id"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
            
                <div class="o_kanban_image_fill_left d-none d-md-block"
                     t-attf-style="background-image:url('#{kanban_image('equipment.assets', 'image_128', record.id.value,  placeholder)}')">
                </div>
                <div class="oe_kanban_details">
                  <h4>
                    <a type="open"><field name="names"/></a>
                  </h4>
                  <ul>
                    <li>Property: <field name="propertys"/></li>
                    <li>Building: <field name="buildings"/></li>
                    <li>Floor : <field name="floors"/></li>
                    <li>Room : <field name="rooms"/></li>
                  </ul>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!--action for brand-->
    <record id="equipment_menu_action" model="ir.actions.act_window">
      <field name="name">Assets</field>
      <field name="res_model">equipment.assets</field>
      <field name="view_mode">kanban,tree,form,pivot</field>
      <field name="context" eval="{'search_default_male': 1}"/>
      <field name="domain">[]</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">Create The Assets</p>
      </field>
    </record>

    <record id="edit_live_project" model="ir.ui.view">
        <field name="name">project.live.view.form.inherit.project.task.unique.code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
          <form string="Project">
            <button name="asset_view" type="object" class="oe_stat_button" icon="fa-clipboard">
              <field name="asset_count" widget="statinfo"/>
            </button>
          </form>
        </field>
    </record>
      
      

    <menuitem id="equipment_menu" name="Assets" sequence="202"/>
    <menuitem id="equipment_models_menu" parent="equipment_menu" name="Assets" action="equipment_menu_action"/>
  </data>
</odoo>
