<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!--form view of the brand menu-->
    <record model="ir.ui.view" id="categoryclassification_view">
      <field name="name">equipmentclassification_form</field>
      <field name="model">equipment.classification</field>
      <field name="arch" type="xml">
        <form string="Equipmentclassification List">
          <sheet>
            <group>
              <field name="name"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="equipmentclassification_status_tree_view" model="ir.ui.view">
      <field name="name">Equipment classification</field>
      <field name="model">equipment.classification</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
        </tree>
      </field>
    </record>

    <!--action for brand-->
    <record id="equipmentclassification_menu_action" model="ir.actions.act_window">
      <field name="name">Assets Classification</field>
      <field name="res_model">equipment.classification</field>
      <field name="view_mode">tree,form,pivot</field>
      <field name="context" eval="{'search_default_male': 1}"/>
      <field name="domain">[]</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">Create The Equipment classification</p>
      </field>
    </record>

    <menuitem id="equipmentclassification_models_menu"
              parent="equipmentcat_models_menu"
              name="Assets Classification"
              action="equipmentclassification_menu_action"
              sequence="23"/>
  </data>
</odoo>
