<odoo>
    <record id="view_invoice_form_mail_replied" model="ir.ui.view">
        <field name="name">account.move.form.mail.replied</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="mail_replied" widget="boolean_button"
                       options="{'terminology': 'yesno'}"
                       class="oe_inline"
                       string="Customer Replied for Remainder mails" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>