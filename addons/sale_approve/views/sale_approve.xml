<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data> 
 
        <record id="sale_orders_view_inherits" model="ir.ui.view">
            <field name="name">Sale Order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
    
                <xpath expr="//button[@name='action_quotation_send']" position="after">
                    <button name="button_approved" string="Approved" type="object" class="btn-primary" groups="sale_approve.group_approval_button" invisible="approval != 'waiting_approval'"/>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position='after'>
                    <field name="approval_req" />
                    <field name="checking_approval" invisible='1'/>
                    <field name="approval" invisible="approval_req == False"/>
                    <field name="approver_user_id" invisible="approval_req == False"/>
                    <field name="approve_date" invisible="approval_req == False"/>
                </xpath>

            <!-- <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='product_id']" position="before">
                <field name="approval_req" /> 
            </xpath> -->
            
            </field>
        </record> 


            <record id="sale_orders_tree_view_inherits" model="ir.ui.view">
            <field name="name">Sale Order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position='after'>
                <field name="approval" />
            </xpath>

            </field>
            </record>


            <record model="ir.actions.act_window" id="action_view_pending_sale_approve">
                <field name="name">Sale Approval</field>
                <field name="res_model">sale.order</field>
                <field name="view_mode">tree,form</field>
                <!-- <field name="context">{'show_custom': True}</field> -->
                <!-- <field name="mode">primary</field> -->
                <field name="domain">[('state', '=', 'draft'),('approval','=','waiting_approval')]</field>
                <field name="help" type="html">
                    <p class="oe_view_nocontent_create">Sale Approval
                    </p>
                </field>
                </record>
    
            <menuitem action="action_view_pending_sale_approve" name="Approval" id="confirm_sale_approval_view" parent="sale.sale_order_menu" sequence='10'/>
    

            <record id="sale_orders_approval_tree_view_inherits" model="ir.ui.view">
                <field name="name">Sale Order</field>
                <field name="model">sale.order</field>
                <field name="inherit_id" ref="sale.view_order_tree"/>
                <field name="arch" type="xml">
    
                <xpath expr="//field[@name='user_id']" position='after'>
                 <field name="approval" />
                </xpath>
    
                </field>
                </record>
    

    </data>
    </odoo>