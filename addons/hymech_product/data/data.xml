<odoo>
    <data noupdate='1'>

        <record id="sequence_self_service_project" model="ir.sequence">
            <field name="name">project sequence</field>
            <field name="code">project.project</field>
            <field name="active">TRUE</field>
            <field name="prefix">JBE </field>
            <field name="padding">4</field>
            <field name="suffix">-%(year)s</field>
            <field name="company_id" eval='False'/>
            <field name="number_next">1</field>
            <field name="number_increment">1</field> 
        </record>
        <record id="sequence_customer_invoice_custom" model="ir.sequence">
            <field name="name">Sale Sequence</field>
            <field name="code">account.move.customer</field>
            <field name="active">TRUE</field>
            <field name="prefix">INE-</field>
            <field name="padding">4</field>
            <field name="company_id" eval='False'/>
        </record>

        <record id="sequence_boq" model="ir.sequence">
            <field name="name">BOQ bill</field>
            <field name="code">product.budget</field>
            <field name="active">TRUE</field>
            <field name="prefix">BOQ-</field>
            <field name="suffix"></field>
            <field name="padding">3</field>
            <field name="company_id" eval='False'/>
            <field name="number_increment">1</field> 
        </record>
    </data>
</odoo>