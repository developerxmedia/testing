<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="process_product_view" model="ir.ui.view">
        <field name="name">process.product.tree</field>
        <field name="model">process.product</field>
        <field name="arch" type="xml">
            <tree string='Material Tree'>
                    <field name="process_product"/>
                    <field name="description"/>

            </tree>
        </field>
    </record>

    <record id="process_product_kanban_view" model="ir.ui.view">
        <field name="name">process.product.kanban</field>
        <field name="model">process.product</field>
        <field name="arch" type="xml">
            <kanban default_group_by="process_product" class="o_kanban_small_column">
        
                    <field name="process_product"/>
                    <field name="description"/>

                  
                    <templates>
                        <t t-name='kanban-box'>
                            <div t-attf-class="oe_kanban_global_click ">
                                    <!-- <div class='o_kanban_image'>
                                        <field name="image" nolabel="1" widget="image" class="oe_right oe_avatar"/>
                                    </div> -->
                            
                                <div class='oe_kanban_details'>
                                        <strong class='o_kanban_record_title'><field name='process_product'/>
                                        </strong>
                                        <ul>
                                            <li> <b>Category: </b><field name='process_product'/></li>
                                            <li> <b>Description: </b><field name='description'/></li>
                                            <!-- <li> <b>Ward Number: </b><field name='ward_number'/></li> -->
                                        </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                    
            </kanban>
        </field>
    </record>

    <record id="process_product_forms_view" model="ir.ui.view">
        <field name="name">process.product.form</field>
        <field name="model">process.product</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>

                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <field name='image' widget='image'  class="oe_avatar" /> -->
                            
                        <h1><field name="process_product" placeholder="Process" class="text-left"/></h1>
                        
                    </div>
                    <div class='oe_right oe_title'>
                        <!-- <field name="qr_code" widget='image' style="float:left;width:50%;" class="oe_avatar"/> -->
                        
                    </div>
                    <group>
                        <field name='description' string='Description'/>
                    </group>
                    <div class='oe_left oe_title'>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="open_process_product" model="ir.actions.act_window">
        <field name="name">Material Description</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">process.product</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>


<menuitem name='Process' action='open_process_product' parent='master' id='process_product' sequence='8'/>
</data>
</odoo>