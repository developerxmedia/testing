<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="equipment_desription_view" model="ir.ui.view">
        <field name="name">equipment.desription.tree</field>
        <field name="model">equipment.desription</field>
        <field name="arch" type="xml">
            <tree string='Equipment Tree'>
                    <field name="types_of_equipment"/>
                    <field name="rate_hour"/>

            </tree>
        </field>
    </record>

    <record id="equipment_desription_kanban_view" model="ir.ui.view">
        <field name="name">equipment.desription.kanban</field>
        <field name="model">equipment.desription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="types_of_equipment" class="o_kanban_small_column">
        
                    <field name="types_of_equipment"/>
                    <field name="rate_hour"/>

                  
                    <templates>
                        <t t-name='kanban-box'>
                            <div t-attf-class="oe_kanban_global_click ">
                                    <!-- <div class='o_kanban_image'>
                                        <field name="image" nolabel="1" widget="image" class="oe_right oe_avatar"/>
                                    </div> -->
                            
                                <div class='oe_kanban_details'>
                                        <strong class='o_kanban_record_title'><field name='types_of_equipment'/>
                                        </strong>
                                        <ul>
                                            <li> <b>Equipment: </b><field name='types_of_equipment'/></li>
                                            <li> <b>Rate per Hour: </b><field name='rate_hour'/></li>
                                            <!-- <li> <b>Ward Number: </b><field name='ward_number'/></li> -->
                                        </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                    
            </kanban>
        </field>
    </record>

    <record id="equipment_desription_forms_view" model="ir.ui.view">
        <field name="name">equipment.desription.form</field>
        <field name="model">equipment.desription</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>

                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <field name='image' widget='image'  class="oe_avatar" /> -->
                            
                        <h1><field name="types_of_equipment" placeholder="Equipment" class="text-left"/></h1>
                        
                    </div>
                    <div class='oe_right oe_title'>
                        <!-- <field name="qr_code" widget='image' style="float:left;width:50%;" class="oe_avatar"/> -->
                        
                    </div>
                    <group>
                        <field name='rate_hour' string='Rate per Hour'/>
                    </group>
                    <div class='oe_left oe_title'>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="open_equipment_desription" model="ir.actions.act_window">
        <field name="name">Equipment Description</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">equipment.desription</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>


<menuitem name='Equipment category' action='open_equipment_desription' parent='master' id='equipment_desription' sequence='5'/>
</data>
</odoo>