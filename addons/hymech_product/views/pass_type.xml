<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="pass_type_view" model="ir.ui.view">
            <field name="name">pass.type.tree</field>
            <field name="model">pass.type</field>
            <field name="arch" type="xml">
                <tree string='Pass Tree'>
                    <field name="pass_type"/>
                </tree>
            </field>
        </record>

        <record id="view_pass_type_line_form" model="ir.ui.view" >
            <field name="name">pass.type.form</field>
            <field name="model">pass.type</field>
            <!-- <field name="type">tree</field> -->
            <field name="arch" type="xml">
                <form>
                    <field name="pass_type"/>
                </form>
            </field>
        </record>

        <record id="open_pass_type" model="ir.actions.act_window">
            <field name="name">Pass Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pass.type</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>


    <menuitem name='Pass Type' id='pass_type_model' parent='pass_details' sequence='10' action="open_pass_type"/>

    </data>
</odoo>