<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="category_design_view" model="ir.ui.view">
            <field name="name">category.design.tree</field>
            <field name="model">category.design</field>
            <field name="arch" type="xml">
                <tree string='Category Tree'>
                    <field name="child"/>
                </tree>
            </field>
        </record>
        <!--kanban view-->

 <record id="view_category_design_kanban" model="ir.ui.view">
            <field name="name">category.design.kanban</field>
            <field name="model">category.design</field>
            <field name="arch" type="xml">
                <kanban  >
                    <field name="id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                
                                <div class="oe_kanban_details">
                                   <strong><field name="parent_id"/></strong>

                                    <div>
                                       
                                    </div>
                                </div>
                            </div>

                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

<!--searchview-->
<record id="view_category_design_search" model="ir.ui.view">                                
  <field name="name">category.design.search</field>                                
  <field name="model">category.design</field>                                
  <field name="arch" type="xml">                                    
    <search string="category design">                                        
                                          
      <group expand="0" string="Group By">                                            
        <filter string="Category" name="parent_id" context="{'group_by': 'parent_id'}"></filter>                                            
                                              
      </group>                                    
    </search>                                
  </field>                            
</record>

        <record id="view_category_design_line_form" model="ir.ui.view" >
            <field name="name">category.design.form</field>
            <field name="model">category.design</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                
                <form>
                <sheet>
                <div>
                    <group class='col-6'>
                        <field name="category_name"/>
                        <field name="parent_id"/>
                        <field name="attachemets" widget="many2many_binary"/>
                        <field name="child" invisible='1'/>
                    </group>
                </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>

        <record id="open_category_design" model="ir.actions.act_window">
            <field name="name">Design Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">category.design</field>
             <field name="search_view_id" ref="view_category_design_search"></field>
              <field name="context">{'search_default_parent_id': 1}</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>

    <menuitem name='Design' id='design_model_new' sequence='190'/>

    <menuitem name='Design Category' id='category_design_model' parent ='design_model_new' sequence='1' action="open_category_design"/>

    </data>
</odoo>