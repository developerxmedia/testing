<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="site_model_view" model="ir.ui.view">
            <field name="name">site.model.tree</field>
            <field name="model">site.model</field>
            <field name="arch" type="xml">
                <tree string='Pass Tree'>
                    <field name="site_name"/>
                </tree>
            </field>
        </record>

        <record id="view_site_model_line_form" model="ir.ui.view" >
            <field name="name">site.model.form</field>
            <field name="model">site.model</field>
            <!-- <field name="type">tree</field> -->
            <field name="arch" type="xml">
                <form>
                    <field name="site_name"/>
                </form>
            </field>
        </record>

        <record id="open_site" model="ir.actions.act_window">
            <field name="name">Site</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">site.model</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>

        <menuitem name='Site' id='site_model' parent='pass_details' sequence='9' action="open_site"/>

    </data>
</odoo>