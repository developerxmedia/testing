<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="hr_employee_line_view" model="ir.ui.view">
            <field name="name">hr.employee.line.tree</field>
            <field name="model">hr.employee.line</field>
            <field name="arch" type="xml">
                <tree string='Employee Tree'>
                    <field name="emp_id"/>
                    <field name="operator"/>
                    <field name="num"/>
                    <field name="attachment" widget='many2many_binary' filename="file_name"/>
                    <!-- <field name="received_date"/> -->
                    <field name="expiry_date"/>
                </tree>
            </field>
        </record>

        <record id="view_employee_form_employee_line_inherit" model="ir.ui.view" >
            <field name="name">hr.employee.line.form</field>
            <field name="model">hr.employee.line</field>
            <!-- <field name="type">tree</field> -->
            <field name="arch" type="xml">
                <form>
                    <field name="operator"/>
                    <field name="num"/>
                    <field name="attachment" widget='many2many_binary' filename="file_name"/>
                    <!-- <field name="received_date"/> -->
                    <field name="expiry_date"/>
                </form>
            </field>
        </record>

        <record id="open_employee" model="ir.actions.act_window">
            <field name="name">Employee</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.employee.line</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>

        <menuitem id="menu_employee_document" name="Employee Document" parent="hr.menu_hr_root" sequence="10" action="open_employee"/>

    </data>
</odoo>