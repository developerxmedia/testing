<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="pass_model_view" model="ir.ui.view">
            <field name="name">pass.model.tree</field>
            <field name="model">pass.model</field>
            <field name="arch" type="xml">
                <tree string='Pass Tree'>
                    <field name="employee_name"/>
                    <field name="expiry_date"/>
                    <field name="pass_name"/>
                    <field name="site_name"/>
                    <field name="pass_type"/>
                </tree>
            </field>
        </record>

        <record id="view_pass_model_line_form" model="ir.ui.view" >
            <field name="name">pass.model.form</field>
            <field name="model">pass.model</field>
            <field name="arch" type="xml">
                <form>
                <div >
                <group>
                    <field name="employee_name"/>
                    <field name="expiry_date"/>
                    <field name="pass_name"/>
                </group>
                <group>
                    <field name="site_name"/>
                    <field name="pass_type"/>
                </group>
                </div>
                </form>
            </field>
        </record>

        <record id="open_pass" model="ir.actions.act_window">
            <field name="name">Pass Master</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pass.model</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>
    
    <menuitem name='Pass Details' id='pass_details'  parent="hr.menu_hr_root" sequence='11'/>
    <menuitem name='Pass' id='pass_model' parent='pass_details' sequence='8' action="open_pass"/>
    </data>
</odoo>