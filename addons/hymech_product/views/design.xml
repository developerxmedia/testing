<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="design_model_view" model="ir.ui.view">
            <field name="name">design.model.tree</field>
            <field name="model">design.model</field>
            <field name="arch" type="xml">
                <tree string='Design Tree'>
                    <field name="design_name"/>
                </tree>
            </field>
        </record>

        <record id="view_design_model_lin_forms" model="ir.ui.view" >
            <field name="name">design.model.form</field>
            <field name="model">design.model</field>
            <field name="arch" type="xml">
                <form>
                    <sheet> 
                        <div class='oe_button_box' name="button_box" >
                            <button name="action_attachement_design" type="object" class="oe_stat_button" icon="fa-clipboard">
                                <field name="design_attachment" widget="statinfo"/>
                            </button>
                        </div>
                        <div>
                            <group class='col-6'>
                                <field name="design_name" label='Name'/>
                                <field name="category"/>
                            </group>
                        </div>
                    </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>

        <record id="open_design_model" model="ir.actions.act_window">
            <field name="name">Design</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">design.model</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>



    </data>
</odoo>
