<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="buy_product_tree_view" model="ir.ui.view">
        <field name="name">buy.product.tree</field>
        <field name="model">buy.product</field>
        <field name="arch" type="xml">
            <tree string='Building Management Tree'>
                    <field name='client_name'/> 
                    <field name='contact'/> 
                    <field name='email'/> 
                 
            </tree>
        </field>
    </record>

    <record id="buy_product_forms_view_rec" model="ir.ui.view">
        <field name="name">buy.product.form</field>
        <field name="model">buy.product</field>
        <field name="arch" type="xml">
            <form>
                <header>

                 </header>

                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <h1><field name="product_name" placeholder="Product Number" class="text-left"/></h1> -->
                    </div>
                    <group>
                        <group>
                            <field name='client_name'/>
                            <field name='contact'/>
                            <field name='address'/>
                            <field name='fax'/>
                            <field name='email'/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name ='man_power'>
                            <field name="product_id" >
                                <tree string="Product Description" editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total_price"/>
                                </tree>
                            </field>
                            <div class ="col-md-4" style="display: flex; align-items: flex-start; justify-content: center;">
                                <label for="total" string="Total Cost : " />
                                <field name ="product_total"/>
                            </div>
                        </page>
                        
                    </notebook>

                </sheet>
                
            </form>
        </field>
    </record>

    <record id="open_buy_product" model="ir.actions.act_window">
        <field name="name">Quotation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">buy.product</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>

<menuitem name='Hymech' id='hymech' sequence='1'/>
<!-- <menuitem name='Quotation' action='open_buy_product' parent='hymech' id='buy_product' sequence='1'/> -->
</data>
</odoo>