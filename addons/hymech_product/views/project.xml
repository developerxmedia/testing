    <record id="view_project_seq_tree_n"  model="ir.ui.view">
        <field name="name">project.project.tree</field>
           <field name="model">project.project</field>
             <field name="inherit_id" ref="project.view_project"/>
             <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="inv_lines"/>
                      <field name="project_status"/>
                    <field name="price" optional="hide" />
                    <field name="expected_price_tasks" optional="hide"/>
                    <field name="profit" optional="hide"/>
                </xpath>
                </field>
            </record>

    <record model="ir.ui.view" id="project_project_list_view_inherit">
        <field name="name">project.project.list.view.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="before">
                <!-- Add your custom field to the list view -->
                <field name="service_number_project"/>
                <field name="sale_order_num"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="project_search_sequence">
        <field name="name">search.projects</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="service_number_project" string="Project Number"/>
            </xpath>
        </field>
    </record>

</odoo>