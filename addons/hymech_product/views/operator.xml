<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <record id="operation_desription_view" model="ir.ui.view">
        <field name="name">operator.master.tree</field>
        <field name="model">operator.master</field>
        <field name="arch" type="xml">
            <tree string='Operator Tree'>
                    <field name="operator"/>


            </tree>
        </field>
    </record>

    <record id="transport_desription_forms_view" model="ir.ui.view">
        <field name="name">operator.master.form</field>
        <field name="model">operator.master</field>
        <field name="arch" type="xml">
            <form>


                <sheet>
                    <div class='oe_left oe_title'>
                        <!-- <field name='image' widget='image'  class="oe_avatar" /> -->
                            
                        <h1><field name="operator" placeholder="Operator" class="text-left"/></h1>
                        
                    </div>


                </sheet>
            </form>
        </field>
    </record>

    <record id="open_operator_master" model="ir.actions.act_window">
        <field name="name">Operation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">operator.master</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create"></p>
        </field>
    </record>


<!-- <menuitem name='Operator' action='open_operator_master' parent='master' id='operator_master' sequence='9'/> -->
</data>
</odoo>