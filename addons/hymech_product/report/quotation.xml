<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="action_report_sale_mas_labellll" model="ir.actions.report">
      <field name="name">Quotation</field>
      <field name="model">sale.order</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">hymech_beta.buying_quotation</field>
      <field name="report_file">hymech_beta.buying_quotation</field>
      <field name="binding_model_id" ref="sale.model_sale_order"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="hymech_beta.paperformat_invoice_pdf"/>
    </record>

<template id="hymech_beta.buying_quotation" name="Quotation">
  <t t-call="web.basic_layout">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">

        <style>
          .page { padding-top: 10px !important; margin-top: 0 !important; }
          table { margin-bottom: 5px !important; page-break-inside: auto; }
          tr { page-break-inside: avoid; page-break-after: auto; }
          thead { display: table-header-group; }
          tfoot { display: table-footer-group; }
          .footer { margin-top: 10px !important; }
          td, th { text-align: left; vertical-align: top; } /* keep all left-aligned by default */
          .terms-section { font-weight: bold; font-size: 16px; }
          .subtotal-table { font-weight: bold; font-size: 16px; }
        </style>

        <div class="page">
          <h4 class="text-center" style="color: blue;"><b>Quotation</b></h4>

          <!-- Header block -->
          <table class="table table-sm border" style="margin-bottom: 5px;border-bottom: 0; width:100%;">
            <tr>
              <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" class="float-left" alt="Logo" style="max-height: 70px;"/>

              <!-- FROM / COMPANY ADDRESS - moved to left side -->
              <td style="border-left: 1px solid white;border-top: 1px solid white;border-bottom: 1px solid white;height:40px;padding:5px;font-size: 16px;width:40%;font-weight: bold;" rowspan="5">
                <br/>
                <span t-field="o.company_id"/><br/>
                <span t-field="o.company_id.street"/><br/>
                <t t-if="o.company_id.street2">
                  <span t-field="o.company_id.street2"/><br/>
                </t>
                <!-- City/State/ZIP on one line -->
                <t t-if="o.company_id.city"><span t-field="o.company_id.city"/></t>
                <t t-if="o.company_id.state_id"> <span t-field="o.company_id.state_id"/></t>
                <t t-if="o.company_id.zip"> <span t-field="o.company_id.zip"/></t><br/>
                <!-- Show Country only if different from City and State (prevents 'Singapore ... Singapore') -->
                <t t-if="o.company_id.country_id and o.company_id.country_id.name != o.company_id.city and o.company_id.country_id.name != o.company_id.state_id.name">
                  <span t-field="o.company_id.country_id"/><br/>
                </t>
                <strong>Tel :</strong> <span t-field="o.company_id.phone"/><br/>
                <strong>Email :</strong> <span t-field="o.company_id.email"/><br/>
                <strong>Tax Reg No# :</strong> <span t-field="o.company_id.vat"/><br/>
              </td>

              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;">Quotation #<br/></td>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;"><span t-field="o.name"/><br/></td>
            </tr>
            <tr>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;">Date</td>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;"><span t-esc="o.write_date" t-options='{"widget": "date"}'/><br/></td>
            </tr>
            <tr>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;">Credit Terms<br/></td>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;"><span t-field="o.cash_term_paid"/><br/></td>
            </tr>
            <tr>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;">Salesperson REF.<br/></td>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;"><span t-field="o.user_id"/><br/></td>
            </tr>
            <!-- RFQ Number row - only show if rfq_num is not empty -->
            <tr t-if="o.rfq_num">
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;">RFQ Number<br/></td>
              <td style="border: 2px solid black;height:15px;width:15%;font-weight: bold;"><span t-field="o.rfq_num"/><br/></td>
            </tr>

            <!-- TO block (left-aligned, consistent <br/>) -->
            <td style="border-left: 1px solid white;border-bottom: 1px solid white;border-right: 1px solid white;font-size: 16px;height:80px;text-align:left;font-weight: bold;">
              <strong>To:</strong><br/>
              <p>
                <span t-field="o.partner_id"/><br/>
                <t t-if="o.partner_id.street">
                  <span t-field="o.partner_id.street"/><br/>
                </t>
                <t t-if="o.partner_id.street2">
                  <span t-field="o.partner_id.street2"/><br/>
                </t>
                <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/></t>
                <t t-if="o.partner_id.state_id"> <span t-field="o.partner_id.state_id"/></t>
                <t t-if="o.partner_id.zip"> <span t-field="o.partner_id.zip"/></t>
                <!-- Show Country only if different from City and State -->
                <t t-if="o.partner_id.country_id and o.partner_id.country_id.name != o.partner_id.city and o.partner_id.country_id.name != o.partner_id.state_id.name">
                  <span t-field="o.partner_id.country_id"/>
                </t><br/>
              </p>
              <strong>Attn:</strong> <span t-field="o.atten.name"/><br/>
              <strong>Tel:</strong> <span t-field="o.atten.phone"/><br/>
              <h4><strong><span style="color: orange;" t-esc="o.product_name.name"/></strong></h4>
            </td>
          </table>

          <!-- Items table with increased font size and bold headers -->
          <table style="width:100%;border: 1px solid black;border-bottom: 1px solid black !important;border-right: 1px solid black; page-break-inside: auto; margin-top: 5px;">
            <thead>
              <tr style="border: 1px solid black;">
                <th style="text-align:center;width:5%;border-right: 1px solid black;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>S.No</b></th>
                <th style="text-align:center;width:61%;border-right: 1px solid black;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>Descriptions</b></th>
                <th style="text-align:center;width:5%;border-right: 1px solid black;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>Qty</b></th>
                <th style="text-align:center;width:5%;border-right: 1px solid black;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>UM</b></th>
                <th style="text-align:center;width:12%;border-right: 1px solid black;white-space: nowrap;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>Unit Price<br/>In SGD</b></th>
                <th style="text-align:center;width:12%;white-space: nowrap;border-bottom: 1px solid black !important;font-weight: bold;font-size: 16px;"><b>Amount In<br/>SGD</b></th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="o.order_line" t-as="line">
                <tr style="border: 1px solid black;border-right: 1px solid black;">
                  <td style="text-align:center;font-weight: bold;"><span style="font-size:16px" t-field="line.s_noss"/></td>
                  <td style="text-align:left;padding-left:4px;line-height:1.3;font-weight: bold;"><span style="font-size:16px" t-field="line.name"/></td>
                  <td style="text-align:center;font-weight: bold;">
                    <t t-if="line.product_uom.name == 'cm2'">
                      <span style="font-size:16px" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                    </t>
                    <t t-else="">
                      <span style="font-size:16px" t-field="line.product_uom_qty" t-options='{"widget": "integer"}'/>
                    </t>
                  </td>
                  <td style="text-align:center;font-weight: bold;"><span style="font-size:16px" t-field="line.product_uom"/></td>
                  <td style="text-align:right;padding-right:4px;font-weight: bold;">$<span style="font-size:16px" t-field="line.price_unit"/></td>
                  <td style="text-align:right;padding-right:4px;font-weight: bold;"><span style="font-size:16px" t-field="line.price_subtotal"/></td>
                </tr>
              </t>
            </tbody>
          </table>

          <!-- Footer / totals -->
          <div class="footer" position="last-page">
            <div class="last-page" style="position:relative;font-size:16px;margin-top:0;">
              <table class="table table-sm border" style="margin-bottom: 0;border-bottom: 0; width:100%;border-top: 1px solid white;">
                <tr>
                  <!-- Terms left (explicit left-align with increased font size and bold) -->
                  <td style="border: 1px solid white;padding:5px;font-size: 16px;width:50%; text-align:left;font-weight: bold;" rowspan="1" class="terms-section">
                    <strong>Terms and Condition:</strong><br/>
                    <span t-field="o.note"/><br/>
                  </td>

                  <!-- Subtotals right with increased font size and bold -->
                  <td style="border: 1px solid white;padding:5px;font-size: 16px;width:50%;font-weight: bold;" rowspan="1">
                    <div style="float:right; width:80%;">
                      <table class="table table-sm subtotal-table" style="page-break-inside: avoid; width:100%;">
                        <tr class="border-black o_subtotal">
                          <td style="width: 50%;font-weight: bold;font-size: 16px;"><strong>Subtotal</strong></td>
                          <td class="text-right" style="font-weight: bold;font-size: 16px;"><span t-field="o.amount_untaxed"/></td>
                        </tr>
                        <tr class="border-black o_subtotal">
                          <td style="font-weight: bold;font-size: 16px;"><strong>GST 9%</strong></td>
                          <td class="text-right" style="font-weight: bold;font-size: 16px;"><span class="text-nowrap" t-field="o.amount_tax"/></td>
                        </tr>
                        <tr class="border-black o_total">
                          <td style="font-weight: bold;font-size: 16px;"><strong>Total</strong></td>
                          <td class="text-right" style="font-weight: bold;font-size: 16px;"><span class="text-nowrap" t-field="o.amount_total"/></td>
                        </tr>
                      </table>
                    </div>
                  </td>
                </tr>
              </table>
            </div>

            <h6 class="text-center" style="font-size: 16px;font-weight: bold;">
              <div style="text-align: center;">
                <b>This is a computer generated Quotation, No signature is required</b>
              </div>
              <br/>
              <strong>Please Visit :</strong> <span t-field="o.company_id.website"/><br/>
            </h6>
            <center style="font-size: 16px;font-weight: bold;">
              <span>Page </span><span class="page"/> of <span class="topage"/>
            </center>
          </div>
        </div>
      </t>
    </t>
  </t>
</template>

  </data>
</odoo>