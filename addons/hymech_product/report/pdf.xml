<?xml version="1.0" encoding="utf-8"?>

<odoo>


 <record id="paperformat_product_budget" model="report.paperformat">
        <field name="name">A4 Custom</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>

        <report id="report_product_budget" 
            string="Product Budget" 
            model="product.budget" 
            report_type="qweb-pdf"
            name="hymech_product.product_budget_form_pdf"
            file="hymech_product.product_budget_form_pdf"
            print_report_name="('BOQ Reports'+'')"
            paperformat="hymech_product.paperformat_product_budget"/>

</odoo>