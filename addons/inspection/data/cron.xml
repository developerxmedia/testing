<?xml version="1.0" encoding="utf-8"?>
<odoo>                                
    <data noupdate="1">                                    
        <record id="ir_cron_inspection_demo_action" model="ir.cron">                                        
          <field name="name">Inspections</field>                                        
          <field name="model_id" ref="model_inspection_request"></field>                                      
          <field name="state">code</field>                                        
          <field name="code">model._cron_generate_requests()</field>                                        
          <field name="active" eval="True"></field>                                        
          <field name="user_id" ref="base.user_root"></field>                                        
          <field name="interval_number">1</field>                                        
          <field name="interval_type">days</field>                                        
          <field name="numbercall">-1</field>                                    
        </record>
        <record id="ir_cron_inspection_task_action" model="ir.cron">                                        
          <field name="name">Inspection Task Creation</field>                                        
          <field name="model_id" ref="model_inspection_plan"></field>                                      
          <field name="state">code</field>                                        
          <field name="code">model.inspection_plan_cron()</field>                                        
          <field name="active" eval="True"></field>                                        
          <field name="interval_number">1</field>                                        
          <field name="interval_type">days</field>                                        
          <field name="numbercall">-1</field>                                    
        </record>                             
    </data>                            
</odoo>