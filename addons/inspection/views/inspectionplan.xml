<odoo>
  <data>
 
      <record model="ir.ui.view" id="inspectionplan_view">
          <field name="name">inspectionplan_form</field>
          <field name="model">inspection.plan</field>
          <field name="arch" type="xml">
              <form string="inspectionplan_form">
                  <sheet>
                      <div class="oe_button_box" name="button_box">
                          <button class="oe_stat_button" type="object" name="get_request" icon="fa-ticket">
                              <field string="Task" name="count" widget="statinfo"/>
                          </button>
                      </div>
                      <div class="oe_title">
                          <h1>
                              <field name="name_seq" readonly="1"/>
                          </h1>
                      </div>
                      <group>
                          <field name="name" string="Inspection Name"/>
                      </group>
                      <group>
                          <field name="asset_type" options="{'horizontal': true}" widget="radio"/>
                      </group>
                      <group>
                          <field name="servicecate"/>
                      </group>
                      <div class="oe_title">
                          <h2>
                              <group>
                                  
                                  <!-- <field name="equipment_id">
                                    <modifier name="invisible">
                                        [('asset_type', '=', 'property')]
                                    </modifier>
                                  </field> -->
                                  <field name="equipment_id" 
                                    string="Project Name"
                                    invisible="asset_type == 'property'"/>
                                
                                  <field name="checklistcat"/>
                              </group>
                          </h2>
                      </div>
                      <group>
                          <group>
                              <field name="created_by"/>
                          </group>
                          <group>
                              <field name="date"/>
                          </group>
                      </group>
                      <group>
                         
                          <group>
                              <field name="start_inspection_date"/>
                          </group>
                          <group>
                            
                              <label for="interval"/>
                              <div class="o_row">
                                  <field name="interval"/>
                                  <field name="interval_step"/>
                              </div>
                              
                          </group>
                          <group>
                              <field name="next_inspection_date"/>
                          </group>
                          <group>
                              <field name="assignto"/>
                          </group>
                          <group>
                              <field name="propertys" invisible="1"/>
                              <field name="building"/>
                              <field name="floor"/>
                              <field name="room"/>
                          </group>
                      </group>
                      <group> </group>
                  </sheet>
              </form>
          </field>
      </record>

      <record id="inspectionplan_status_tree_view" model="ir.ui.view">
          <field name="name">Inspection plan</field>
          <field name="model">inspection.plan</field>
          <field name="arch" type="xml">
              <tree>
                  <field name="name_seq"/>
                  <field name="name"/>
                  <field name="created_by"/>
                  <field name="assignto"/>
                  <field name="start_inspection_date"/>
                  <field name="next_inspection_date"/>
              </tree>
          </field>
      </record>

    
      <record id="inspectionplan_menu_action" model="ir.actions.act_window">
          <field name="name">Inspection Plan</field>
          <field name="res_model">inspection.plan</field>
          <field name="view_mode">tree,form,kanban</field>
          <field name="context" eval="{'search_default_male': 1}"/>
          <field name="domain">[]</field>
          <field name="help" type="html">
              <p class="oe_view_nocontent_create">Create The First inspection Plan</p>
          </field>
      </record>


   
       <!-- <menuitem id="inspection_plan_simple_menu"
                name="Inspection Plan"
                parent="checkinspection_menu"
                action="inspectionplan_menu_action"
                sequence="15"
                groups="base.group_user"/> -->
  </data>
</odoo>
