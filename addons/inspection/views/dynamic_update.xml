<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="dynamic_update_tree" model="ir.ui.view">
            <field name="name">Message Content Tree</field>
            <field name="model">message.content</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Message Content">
                    <field name="message"/>
                    <field name="date_time"/>
                    <field name="event"/>
                    <field name="status"/>
                    <field name="time"/>
                    <field name="interval"/>
                    <field name="select_type"/>
                </tree>
            </field>
        </record>

        <record id="dynamic_update_form" model="ir.ui.view">
            <field name="name">Message Content Form</field>
            <field name="model">message.content</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Message Content">
                    <sheet>
                        <group>
                            <field name="message"/>
                            <field name="date_time"/>
                            <field name="event"/>
                            <field name="status"/>
                            <field name="time"/>
                            <field name="interval"/>
                            <field name="select_type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="dynamic_update_action">
            <field name="name">Message Content</field>
            <field name="res_model">message.content</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create"></p>
            </field>
        </record>

        <!-- Uncomment below to have a top-level menu -->
        <!-- <menuitem id='main_menu_message_content' name='Message Content' action="dynamic_update_action" sequence="1"/> -->
        <menuitem id="menu_message_content" name="Message Content" parent="check_menu" action="dynamic_update_action" sequence="5"/>

    </data>
</odoo>
