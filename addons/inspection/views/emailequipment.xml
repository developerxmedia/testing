<odoo>
    <data>
        <record id="emailequip_Update" model="mail.template">
            <field name="name">EQUIPMENT TEMPLATE</field>
            <field name="model_id" ref="inspection.model_inspectiontwo_check_twoline"/>       
            <field name="auto_delete" eval="True"/>
            <field name="email_from">${object.name_seq}</field>
            <field name="email_to">${object.property}</field>
            <!-- <field name="subject">${object.amc}</field> -->
            <field name="body_html"><![CDATA[
                <p>No: ${object.name_seq},<br/><br/>
                Your Inspection has been Failed!<br/></p>
                Regards,<br/>
            ]]></field> 
            <field name="report" ref="inspection.sampleequip_report_cards"/>
        </record>
    </data>
</odoo>

