<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	  <data>
        <!--form view of the brand menu-->
        <record model="ir.ui.view" id="inspectortype_view">
          <field name="name">inspectortype_form</field>
          <field name="model">inspector.task</field>
          <field name="arch" type="xml">
            <form string="inspector  Type">
              <sheet>
                <group>
                  <group><field name="name">name</field></group>
                  <group><field name="created_by">created_by</field></group>
                  <group><field name="scheduleddate">scheduleddate</field></group>
                  <group><field name="date">date</field></group>
                  <group><field name="assignto">assignto</field></group>
                  <group><field name="inspectionstart">inspectionstart</field></group>
                  <group><field name="asset_type" options="{'horizontal': true}" widget="radio">asset_type</field></group>
                  <group><field name="inspectionend">inspectionend</field></group>
                </group>
                <notebook>
                  <page string="Inspection List">
                    <field name="inspector_lines">
                      <tree string="Inspector" editable="bottom">
                        <field name="building"/>
                        <field name="floor"/>
                        <field name="room"/>
                        <field name="checklistname"/>
                        <field name="checklistitem"/>
                        <field name="inspectionfind"/>
                        <field name="inspectionresult"/>
                        <field name="comments"/>
                        <field name="identity_card" widget="many2many_binary"/>
                      </tree>
                    </field>
                  </page>
                </notebook>
              </sheet>
            </form>
          </field>
        </record>

        <record id="inspectortype_tree_view" model="ir.ui.view">
          <field name="name">inspector Type</field>
          <field name="model">inspector.task</field>
          <field name="arch" type="xml">
            <tree>
              <field name="name"/>
              <field name="scheduleddate"/>
              <field name="created_by"/>
              <field name="date"/>
              <field name="assignto"/>
              <field name="asset_type"/>
              <field name="inspectionstart"/>
              <field name="inspectionend"/>
            </tree>
          </field>
        </record>

        <!--action for brand-->
        <record id="inspectortype_menu_action" model="ir.actions.act_window">
          <field name="name">Inspector Task</field>
          <field name="res_model">inspector.task</field>
          <field name="view_mode">tree,form,kanban</field>
          <field name="context" eval="{'search_default_male': 1}"/>
          <field name="domain">[]</field>
          <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create The First Inspector Request</p>
          </field>
        </record>

        <menuitem id="inspectortype_models_menu"
          parent="inspectioncheck_models_menu"
          name="Inspector Task"
          action="inspectortype_menu_action" sequence="1"/>
	  </data>
</odoo>
