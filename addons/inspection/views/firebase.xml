<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record model="ir.ui.view" id="notificationlist_tree">
            <field name="name">Notification</field>
            <field name="model">notification.list</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <tree string="Notification" default_order="id desc">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="read_status"/>
                    <field name="res_users" string="User"/>
                    <field name="res_partner_id" string="Partner"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="list_notification_form">
            <field name="name">notification.list</field>
            <field name="model">notification.list</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="notification">
                    <sheet>
                        <field name="image" widget="image" style="width:7%"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="read_status"/>
                                <field name="date"/>
                                <field name="inspection_task"/>
                                <field name="background_image" widget="image" style="width:30%"/>
                            </group>
                            <group>
                                <field name="res_users" string="User"/>
                                <field name="res_partner_id" string="Partner"/>
                                <field name="manager" string="Is Manager"/>
                                <field name="user" string="Is User"/>
                                <field name="tech" string="Is Tech"/>
                            </group>
                        </group>
                        <field name="description" nolabel="1"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" string="mail"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread" string="Mail"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_notificationlist">
            <field name="name">Notification Alerts</field>
            <field name="res_model">notification.list</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Notification List</p>
            </field>
        </record>

        <menuitem id="menu_notification_masters" name="Notification Alerts" sequence="8"/>
        <menuitem id="menu_notification_master" name="Notification List" parent="menu_notification_masters" action="action_notificationlist" sequence="1"/>
        <!-- <menuitem id="configuration_notification_menu" name="Configuration" parent="menu_notification_masters" sequence="50"/> -->
    </data>
</odoo>
