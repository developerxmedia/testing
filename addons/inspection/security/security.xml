<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_inspection">
        <field name="name">Inspection Management</field>
        <field name="description"> Category For inspection </field>
    </record>

    <record id="group_inspection_admin" model="res.groups">
        <field name="name">Inspection Admin</field>
                 <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_inspection"/>
    </record>

    <record id="group_inspection_user" model="res.groups">
        <field name="name">Inspection User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
        <field name="category_id" ref="module_category_inspection"/> 
    </record>

    <record  model="ir.rule" id="inspection_record_rule">
        <field name="name">See only is Inspection</field>
        <field name="model_id" ref="model_inspection_request"/>
        <field name="domain_force">[('assignto.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_inspection_user'))]"/>
    </record>

    <!--newfilterusercontact-->
    <record  model="ir.rule" id="cell_record_checkresult">
        <field name="name">See only is checkresultproperty</field>
        <field name="model_id" ref="model_inspection_check_twoline"/>
        <field name="domain_force">[('checktwoline_inspection.assignto.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_inspection_user'))]"/>
    </record>

    <!--newfilterusercontacts-->
    <record  model="ir.rule" id="cell_record_resultequip">
        <field name="name">See only is checkresultequip</field>
        <field name="model_id" ref="model_inspectiontwo_check_twoline"/>
        <field name="domain_force">[('checktwoline_insp.assignto.user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_inspection_user'))]"/>
    </record>

    <!--newmenu-->

    <record id="group_inspection_menu" model="res.groups">
        <field name="name">Show  inspection Task</field>
        <!--<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
        <field name="category_id" ref="module_category_inspection"/>
    </record>
    
    <!--menu1-->
    <!-- <record   model="ir.ui.menu" id="inspection.inspectionplan_models_menu">
        <field name="groups_id" eval="[(4, ref('inspection.group_inspection_menu'))]"/>
    </record> -->
    <menuitem id="inspection.inspectionplan_models_menu"
          name="Inspection Plan"
          parent="base.menu_custom"
          groups="inspection.group_inspection_menu"/>

</odoo>
